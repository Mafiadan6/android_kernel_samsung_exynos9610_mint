# Kernel configurations for DroidSpaces support for non-GKI
# Copyright (C) 2026 ravindu644 <droidcasts@protonmail.com>

# SYSVIPC is required for IPC namespace
CONFIG_SYSVIPC=y

# IPC namespace (REQUIRED)
CONFIG_IPC_NS=y

# Network isolation support (optional but recommended)
CONFIG_VETH=y
CONFIG_BRIDGE=y

# Keep USER_NS disabled per DroidSpaces hardening recommendation
CONFIG_USER_NS=n
